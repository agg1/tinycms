diff -Naur linux-5.9.16-gentoo.orig/security/wxprot/Kconfig linux-5.9.16-gentoo/security/wxprot/Kconfig
--- linux-5.9.16-gentoo.orig/security/wxprot/Kconfig	1970-01-01 00:00:00.000000000 +0000
+++ linux-5.9.16-gentoo/security/wxprot/Kconfig	2020-12-27 12:49:18.961045453 +0000
@@ -0,0 +1,50 @@
+config SECURITY_WXPROT
+	bool "WX Protection: W^X and W!->X protections"
+	default y
+	help
+	  WX Protections applied to user-space processes:
+	    - W^X memory restriction
+	    - W!->X (once writable never executable) mprotect restriction
+	    - Executable MMAP prevention
+
+	  If unsure, answer Y.
+
+choice
+	prompt "Default W^X and W!->X protections"
+	depends on SECURITY_WXPROT
+	default SECURITY_WXPROT_DEFAULT_FLAGS_ALL_COMPLAIN_VERBOSE
+
+	help
+	  Default WX protection if no rule exception is configured.
+
+	config SECURITY_WXPROT_DEFAULT_FLAGS_ALL_COMPLAIN_VERBOSE
+		bool "Protections enabled but not enforced."
+		help
+		  All protections complain mode: 0x7f
+		  Violations are logged but not prevented by wxprot.
+
+	config SECURITY_WXPROT_DEFAULT_FLAGS_ALL_ENFORCE_VERBOSE
+		bool "Full protection, verbose."
+		help
+		  All protections enforced: 0x6f
+		  Violations are logged.
+
+	config SECURITY_WXPROT_DEFAULT_FLAGS_ALL_ENFORCE
+		bool "Full protection, quiet."
+		help
+		  All protections except "Executable MMAP": 0x0f
+		  Violations are logged.
+
+	config SECURITY_WXPROT_DEFAULT_FLAGS_NONE
+		bool "No protection at all."
+		help
+		  Protection disabled: 0x00
+
+endchoice
+
+config SECURITY_WXPROT_DEFAULT_FLAGS
+	hex
+	default "0x7f" if SECURITY_WXPROT_DEFAULT_FLAGS_ALL_COMPLAIN_VERBOSE
+	default "0x6f" if SECURITY_WXPROT_DEFAULT_FLAGS_ALL_ENFORCE_VERBOSE
+	default "0x0f" if SECURITY_WXPROT_DEFAULT_FLAGS_ALL_ENFORCE
+	default "0x00" if SECURITY_WXPROT_DEFAULT_FLAGS_NONE
