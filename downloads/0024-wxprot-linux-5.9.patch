+
+#ifndef __WXPROT_SECURITYFS_H
+#define __WXPROT_SECURITYFS_H
+
+#include <linux/init.h>
+
+#define WXPROT_SUBTREE_NN_LEN 24
+#define WXPROT_CONFIG_HASH_LEN 20
+
+struct wxprot_secfs_node;
+
+int wxprot_secfs_init(void) __init;
+int wxprot_secfs_subtree_register(const char *subtree_name,
+				const struct wxprot_secfs_node *nodes,
+				size_t size) __init;
+
+enum wxprot_secfs_node_type {
+	WXPROT_SECFS_BOOL,
+	WXPROT_SECFS_READONLY_INT,
+	WXPROT_SECFS_CONFIG_LOAD,
+	WXPROT_SECFS_CONFIG_DUMP,
+	WXPROT_SECFS_CONFIG_HASH,
+};
+
+struct wxprot_secfs_node {
+	const enum wxprot_secfs_node_type type;
+	void *const data;
+	const size_t dir_contents_len;
+	const char name[WXPROT_SUBTREE_NN_LEN];
+};
+
+struct wxprot_secfs_fptrs {
+	int (*const load)(const char *, size_t);
+	ssize_t (*const dump)(char **);
+	int (*const hash)(char **);
+};
+
+struct wxprot_secfs_bool_flag {
+	const char notice_line[WXPROT_SUBTREE_NN_LEN];
+	bool *const flag;
+};
+
+#define DEFINE_WXPROT_SECFS_BOOL_FLAG(NAME, VAR)		\
+const struct wxprot_secfs_bool_flag NAME = {		\
+	.notice_line = #VAR,				\
+	.flag = &VAR,					\
+}
+
+#endif /* __WXPROT_SECURITYFS_H */
